{% extends "base.html" %}
{% block title %}Control Panel{% endblock %}

{% block content %}
<div class="row">
  <div class="col-12">
    <div class="card">
      <div class="card-header">
        <h4>System Details</h4>
      </div>
      <div class="card-body">
        <p><strong>Hostname:</strong> {{ details.get('hostname', 'N/A') }}</p>
        <p><strong>Location:</strong> {{ details.get('location', 'N/A') }}</p>
        <p><strong>Purpose:</strong> {{ details.get('purpose', 'N/A') }}</p>
      </div>
    </div>
  </div>
</div>

<div class="row mt-4">
  <div class="col-md-6">
    <div class="card">
      <div class="card-header">
        <h4>Trigger Actions</h4>
      </div>
      <div class="card-body">
        <p>Click a button to trigger an action on the Raspberry Pi.</p>
        <div class="d-grid gap-2">
          <button class="btn btn-primary action-btn" data-action="blink">Blink LED</button>
          <button class="btn btn-warning action-btn" data-action="reboot">Reboot Pi</button>
          <button class="btn btn-danger action-btn" data-action="shutdown">Shutdown Pi</button>
        </div>
      </div>
    </div>
  </div>
  <div class="col-md-6">
    <div class="card">
      <div class="card-header d-flex justify-content-between align-items-center">
        <h4>Action History</h4>
        <button id="refresh-logs-btn" class="btn btn-sm btn-outline-secondary">Refresh</button>
      </div>
      <div class="card-body p-0">
        <div class="table-responsive" style="max-height: 300px;">
          <table class="table table-striped table-hover mb-0">
            <thead class="table-light sticky-top">
              <tr>
                <th>Time</th>
                <th>Action</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody id="action-log-table-body">
              <!-- Logs will be loaded here by JavaScript -->
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>
{% endblock %}

{% block scripts %}
<script src="{{ url_for('static', filename='js/control_panel.js') }}"></script>
{% endblock %}
